# Urls prefix [useful to change between HTTPS/WSS/Backend Version]
DEBUG_MODE=true
NEXT_PUBLIC_HTTP_PROTOCOLE=http
HTTP=http://
WS=ws://
# CORS - Allowed origins for API requests (comma-separated)
ALLOWED_ORIGINS=localhost:3002
# next js backend api (for cookies)
NEXT_PUBLIC_BACKEND_DOMAIN=localhost:3002
NEXT_PUBLIC_BACKEND_API="${HTTP}${NEXT_PUBLIC_BACKEND_DOMAIN}/api"
NEXT_PUBLIC_API_ROOT_URL=localhost
NEXT_PUBLIC_API_ROOT_PORT=8002
NEXT_PUBLIC_API_URL="${HTTP}${NEXT_PUBLIC_API_ROOT_URL}:${NEXT_PUBLIC_API_ROOT_PORT}"
# Base urls
NEXT_PUBLIC_ROOT_API_URL="${HTTP}${NEXT_PUBLIC_API_ROOT_URL}:${NEXT_PUBLIC_API_ROOT_PORT}/api"
NEXT_PUBLIC_ROOT_WS_URL="${WS}${NEXT_PUBLIC_API_ROOT_URL}:${NEXT_PUBLIC_API_ROOT_PORT}/ws"
NEXT_PUBLIC_WS_MAINTENANCE_ROOT=/ws/maintenance/
# to remove in production
AUTH_TRUST_HOST=true
NEXTAUTH_SECRET=authSecretKey
NEXTAUTH_URL="${HTTP}${NEXT_PUBLIC_BACKEND_DOMAIN}"
NEXT_PUBLIC_DOMAIN_URL_PREFIX="${HTTP}${NEXT_PUBLIC_BACKEND_DOMAIN}"
# Account
NEXT_PUBLIC_ACCOUNT_ROOT=/account
NEXT_PUBLIC_ACCOUNT_REFRESH_TOKEN=$NEXT_PUBLIC_ACCOUNT_ROOT/token_refresh/
NEXT_PUBLIC_ACCOUNT_LOGIN=$NEXT_PUBLIC_ACCOUNT_ROOT/login/
NEXT_PUBLIC_ACCOUNT_LOGOUT=$NEXT_PUBLIC_ACCOUNT_ROOT/logout/
NEXT_PUBLIC_ACCOUNT_CREATE_ACCOUNT=$NEXT_PUBLIC_ACCOUNT_ROOT/create_account/
NEXT_PUBLIC_ACCOUNT_CHECK_EMAIL=$NEXT_PUBLIC_ACCOUNT_ROOT/check_email/
NEXT_PUBLIC_ACCOUNT_PASSWORD_CHANGE=$NEXT_PUBLIC_ACCOUNT_ROOT/password_change/
NEXT_PUBLIC_ACCOUNT_SEND_PASSWORD_RESET=$NEXT_PUBLIC_ACCOUNT_ROOT/send_password_reset/
NEXT_PUBLIC_ACCOUNT_PASSWORD_RESET=$NEXT_PUBLIC_ACCOUNT_ROOT/password_reset/
NEXT_PUBLIC_ACCOUNT_PROFIL=$NEXT_PUBLIC_ACCOUNT_ROOT/profil/
NEXT_PUBLIC_USERS_ROOT=$NEXT_PUBLIC_ACCOUNT_ROOT/users/
NEXT_PUBLIC_ACCOUNT_SSO_EXCHANGE=$NEXT_PUBLIC_ACCOUNT_ROOT/sso/exchange/
NEXT_PUBLIC_EBH_SSO_AUTHORIZE_URL=http://localhost:3004/sso/authorize
NEXT_PUBLIC_EBH_SSO_APP_SLUG=reservation
# Reservations
NEXT_PUBLIC_RESERVATION_ROOT=/reservation
NEXT_PUBLIC_RESERVATION_LIST=$NEXT_PUBLIC_RESERVATION_ROOT/
NEXT_PUBLIC_RESERVATION_APARTMENTS=$NEXT_PUBLIC_RESERVATION_ROOT/apartments/
NEXT_PUBLIC_RESERVATION_DASHBOARD=$NEXT_PUBLIC_RESERVATION_ROOT/dashboard/
NEXT_PUBLIC_RESERVATION_PLANNING=$NEXT_PUBLIC_RESERVATION_ROOT/planning/
NEXT_PUBLIC_RESERVATION_BALANCE=$NEXT_PUBLIC_RESERVATION_ROOT/balance/
NEXT_PUBLIC_RESERVATION_YEARS=$NEXT_PUBLIC_RESERVATION_ROOT/years/
NEXT_PUBLIC_RESERVATION_OCCUPIED_DATES=$NEXT_PUBLIC_RESERVATION_ROOT/occupied-dates/
NEXT_PUBLIC_RESERVATION_PAYMENT_SOURCES=$NEXT_PUBLIC_RESERVATION_ROOT/payment-sources/
NEXT_PUBLIC_RESERVATION_COSTS=$NEXT_PUBLIC_RESERVATION_ROOT/costs/
NEXT_PUBLIC_RESERVATION_COST_YEARS=$NEXT_PUBLIC_RESERVATION_ROOT/costs/years/
NEXT_PUBLIC_RESERVATION_COST_CATEGORIES=$NEXT_PUBLIC_RESERVATION_ROOT/cost-categories/
NEXT_PUBLIC_RESERVATION_HILTON_REPORTS=$NEXT_PUBLIC_RESERVATION_ROOT/hilton-reports/
# Locaux
NEXT_PUBLIC_LOCAL_ROOT=/local
NEXT_PUBLIC_LOCAL_TYPES=$NEXT_PUBLIC_LOCAL_ROOT/types/
NEXT_PUBLIC_LOCAL_LIST=$NEXT_PUBLIC_LOCAL_ROOT/locaux/
NEXT_PUBLIC_LOYER_LIST=$NEXT_PUBLIC_LOCAL_ROOT/loyers/
NEXT_PUBLIC_LOCAL_PLANNING=$NEXT_PUBLIC_LOCAL_ROOT/planning/
NEXT_PUBLIC_LOCAL_DASHBOARD=$NEXT_PUBLIC_LOCAL_ROOT/dashboard/
NEXT_PUBLIC_LOCAL_YEARS=$NEXT_PUBLIC_LOCAL_ROOT/years/
# Buildings
NEXT_PUBLIC_BUILDING_LIST=/building/buildings/
# Notifications
NEXT_PUBLIC_RESERVATION_NOTIFICATION_ROOT=/notifications
NEXT_PUBLIC_RESERVATION_NOTIFICATIONS=$NEXT_PUBLIC_RESERVATION_NOTIFICATION_ROOT/
NEXT_PUBLIC_RESERVATION_NOTIFICATION_PREFERENCES=$NEXT_PUBLIC_RESERVATION_NOTIFICATION_ROOT/preferences/
NEXT_PUBLIC_RESERVATION_NOTIFICATION_MARK_READ=$NEXT_PUBLIC_RESERVATION_NOTIFICATION_ROOT/mark-read/
NEXT_PUBLIC_RESERVATION_NOTIFICATION_UNREAD_COUNT=$NEXT_PUBLIC_RESERVATION_NOTIFICATION_ROOT/unread-count/
